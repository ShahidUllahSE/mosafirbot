PORT=3000

# Your teammate's webhook URL — Mosafir POSTs incoming text messages here
TEAMMATE_WEBHOOK_URL=https://your-teammate-server.com/webhooks/mosafir/text

# Optional secret sent as X-Webhook-Secret header when forwarding messages
WEBHOOK_SECRET=

# Optional API key required on reply endpoints (header: X-API-Key)
REPLY_API_KEY=

# Cloudinary — used to store incoming customer media (already in your .env)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
